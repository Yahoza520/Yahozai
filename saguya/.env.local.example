# Saguya Health — ortam değişkenleri örneği
# Bu dosyayı ".env.local" adıyla KOPYALAYIN ve değerleri doldurun.
# .env.local dosyası .gitignore ile korunur; anahtarlar ASLA git'e gönderilmez.

# Supabase proje ayarlarından alınır (Project Settings > API):
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# DİKKAT: "service_role" (gizli) anahtar buraya YAZILMAZ.
# Sadece sunucu tarafı, korumalı işlemler gerektiğinde ve NEXT_PUBLIC_ öneki
# OLMADAN ileriki fazlarda eklenecektir.
